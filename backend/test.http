  "type": "industrial",
  "location": "Visakhapatnam",
  "status": "new"
}

### Admin - Get All Leads
GET {{baseUrl}}/api/leads
Authorization: Bearer {{adminToken}}

### Admin - Get Lead
GET {{baseUrl}}/api/leads/6aa56093347caa115ad4fe57
Authorization: Bearer {{adminToken}}

### Admin - Update Lead
PUT {{baseUrl}}/api/leads/6aa56093347caa115ad4fe57
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "qualified"
}

### Admin - Delete Lead
DELETE {{baseUrl}}/api/leads/6aa56093347caa115ad4fe57
Authorization: Bearer {{adminToken}}

### =========================================================
### 5. ENQUIRIES
### =========================================================

### Public - Submit Enquiry
POST {{baseUrl}}/api/enquiries
Content-Type: application/json

{
  "fullName": "Mohan Das",
  "companyName": "ABC Industries",
  "phoneNumber": "9876543210",
  "emailAddress": "mohan@example.com",
  "projectLocation": "Visakhapatnam",
  "projectType": "Commercial Solar",
  "monthlyElectricityBill": 45000,
  "message": "Interested in installing a rooftop solar system."
}

### Public - Submit Enquiry with Invalid Email
POST {{baseUrl}}/api/enquiries
Content-Type: application/json

{
  "fullName": "Mohan Das",
  "phoneNumber": "9876543210",
  "emailAddress": "not-an-email",
  "projectType": "Commercial Solar"
}

### Admin - Get All Enquiries
GET {{baseUrl}}/api/enquiries
Authorization: Bearer {{adminToken}}

### Admin - Get Enquiry
GET {{baseUrl}}/api/enquiries/6aa560db347caa115ad4fe61
Authorization: Bearer {{adminToken}}

### Admin - Resolve Enquiry
PATCH {{baseUrl}}/api/enquiries/6aa560db347caa115ad4fe61/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "Resolved"
}

### Admin - Delete Enquiry
DELETE {{baseUrl}}/api/enquiries/6aa560db347caa115ad4fe61
Authorization: Bearer {{adminToken}}

### Unauthorized - Enquiries List
GET {{baseUrl}}/api/enquiries

### =========================================================
### 6. PROJECTS
### =========================================================

### ---------------- ADMIN PROJECT APIS ----------------

### Admin - Create Project (multipart/form-data)
POST {{baseUrl}}/api/projects
Authorization: Bearer {{adminToken}}
Content-Type: multipart/form-data; boundary=ProjectBoundary

--ProjectBoundary
Content-Disposition: form-data; name="title"

Visakhapatnam Solar Installation
--ProjectBoundary
Content-Disposition: form-data; name="category"

industrial
--ProjectBoundary
Content-Disposition: form-data; name="location"

Visakhapatnam
--ProjectBoundary
Content-Disposition: form-data; name="description"

Industrial rooftop solar installation project.
--ProjectBoundary
Content-Disposition: form-data; name="services"

["Solar Installation","System Design","Maintenance"]
--ProjectBoundary
Content-Disposition: form-data; name="status"

in_progress
--ProjectBoundary
Content-Disposition: form-data; name="image"; filename="project-image.jpg"
Content-Type: image/jpeg

< {{projectImage}}
--ProjectBoundary--

### Admin - Get All Projects
GET {{baseUrl}}/api/projects
Authorization: Bearer {{adminToken}}

### Admin - Get Project
GET {{baseUrl}}/api/projects/6a9ed3f87aa1d5f60a8c71c6
Authorization: Bearer {{adminToken}}


### Admin - Update Project Status
PATCH {{baseUrl}}/api/projects/6a9ed3f87aa1d5f60a8c71c6/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "completed"
}

### Admin - Delete Project
DELETE {{baseUrl}}/api/projects/6ab3a1cf4f5165336b6d1051
Authorization: Bearer {{adminToken}}

