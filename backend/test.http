### =========================================================
### 1. AUTHENTICATION
### =========================================================

### Admin - Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
X-Admin-Registration-Key: {{$dotenv ADMIN_REGISTRATION_KEY}}

{
  "name": "NSolutions Admin",
  "email": "admin@nsolutions.com",
  "password": "StrongPassword123"
}

### Admin - Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@nsolutions.com",
  "password": "StrongPassword123"
}

### =========================================================
### 2. ADMIN PROFILE
### =========================================================

### Admin - Get Profile
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer {{adminToken}}

### Admin - Update Profile
PATCH {{baseUrl}}/api/auth/profile
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "fullName": "Nolutions Admin",
  "emailAddress": "admin@nsolutions.com"
}

### Admin - Change Password
PATCH {{baseUrl}}/api/auth/profile/password
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "currentPassword": "NewStrongPassword123",
  "newPassword": "StrongPassword123"
}

