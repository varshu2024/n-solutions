### Public - Submit Job Application (multipart/form-data)
POST {{baseUrl}}/api/job-applications
Content-Type: multipart/form-data; boundary=JobApplicationBoundary

--JobApplicationBoundary
Content-Disposition: form-data; name="jobId"

6aa56dfddc981def9a25db18
--JobApplicationBoundary
Content-Disposition: form-data; name="fullName"

Ravi Kumar
--JobApplicationBoundary
Content-Disposition: form-data; name="email"

ravi@example.com
--JobApplicationBoundary
Content-Disposition: form-data; name="phoneNumber"

9876543210
--JobApplicationBoundary
Content-Disposition: form-data; name="positionAppliedFor"

Solar Design Engineer
--JobApplicationBoundary
Content-Disposition: form-data; name="yearsOfExperience"

2
--JobApplicationBoundary
Content-Disposition: form-data; name="message"

I am interested in this position.
--JobApplicationBoundary
Content-Disposition: form-data; name="resume"; filename="resume.pdf"
Content-Type: application/pdf

< {{resumeFile}}
--JobApplicationBoundary--

